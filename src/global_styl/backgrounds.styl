// Pages with a space background: black behind the SpaceBackground component's
// stars/satellite/planet layers. `isolation` gives the root its own stacking
// context so the background's z-index -1 stays above the root's own colour
// but below the page content.
.bg-blue, .bg-yellow, .bg-green, .bg-magenta, .bg-red {
    background-color: #000 !important;
    isolation: isolate;
}
