.AvatarSelection {
    flex: 1;

    display: inline-flex;
    flex-direction: column;
    align-items: center;
    align-content: center;
    justify-content: center;
    margin-top: 1rem;

    .race-selection-icons {
        button {
            border: 1px solid #888;
            border-radius: 0.25rem;
            margin: 0.2rem;
        }
        button.active {
            background-color: #75D4CB;
        }
    }


    .selector {
        display: inline-flex;
        justify-content: center;
        margin-top: 1rem;

        .previous, .next {
            flex: 0;
            display: inline-flex;
            align-items: center;
            padding: 0.5rem;
        }
    }

    .race-selection-icons {
        display: inline-flex;
        align-items: center;
        align-content: center;
        justify-content: center;
        padding: 1rem;
        // Matches the Player Avatar box above so it reads as sitting in front
        // of the planet rather than the horizon cutting through it.
        background-color: rgba(120, 120, 120, 0.9);
        border: 2px solid white;
        backdrop-filter: blur(4px);
        border-radius: 1rem;
    }

    // The slot keeps its size and takes the hover/click; only the icon inside
    // scales, and it ignores the mouse, so the hover ends as soon as the
    // pointer leaves the original box rather than the grown one.
    .race-icon {
        position: relative;
        width: 6rem;
        height: 6rem;
        margin: 0 0.15rem;
        cursor: pointer;

        // Five 6rem slots don't fit a phone held upright.
        +portrait() {
            width: 4rem;
            height: 4rem;
        }

        // A modest pop: enough to come forward over its neighbours without
        // spilling past the panel onto the "Change Species" label.
        &:hover {
            z-index: 2;

            .icon {
                transform: scale(1.35);
            }
        }

        &:hover .icon, &.active .icon {
            border 2px solid white;
            background-color: rgba(255,255,255,0.4);
        }
    }

    .Avatar-svg.icon {
        display: inline-block;
        width: 100%;
        height: 100%;
        box-sizing: border-box;
        border 2px solid transparent;
        border-radius: 0.5rem;
        transition: hover-pop-transition;
        pointer-events: none;
    }

    .selector {
        flex: 1;
        display: flex;
        width: 80vw;

        align-items: stretch;
        align-content: center;
        justify-content: center;
        .previous, .next {
            flex: 0;
        }
        .Avatar {
            display: inline-flex;
            align-items: center;
            align-content: center;
            justify-content: center;
            flex: 1;
            max-width: 50vw;
            .Avatar-svg {
                width: 100%;
                height: 100%;
                max-width: 100%;
                max-height: 100%;
                transition: hover-pop-transition;
                pointer-events: none;
                // Rests slightly small and grows to its full layout box on
                // hover (~20% pop), so it never spills onto the species row
                // above or the Done button below.
                transform: scale(0.85);
            }

            &:hover .Avatar-svg {
                transform: scale(1);
            }
        }
    }


    .race-selection-container {
        display: inline-flex;
        align-items: center;
        align-content: center;
        justify-content: center;
        margin-top: 2rem;
        margin-bottom: 0.5rem;

        .race-selection-title {
            font-size: 0.9rem;
            letter-spacing: 0.2rem;
            background-color: rgba(40,40,40,0.8);
            border: 2px solid white;
            border-radius: 0.5rem;
            padding: 0.3rem;
            padding-left: 2rem;
            padding-right: 2rem;
            color: white;
        }
    }
}

.pluses {
    color: white;
    font-family: fixed;
    font-size: 1.2rem;
    margin-left: 1rem;
    margin-right: 1rem;
}
