.SpaceBackground {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background-color: #000;

    .SpaceBackground-stars {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    // Cruises from just past the right edge to just past the left, dipping a
    // little as it goes. The satellite art fills roughly the middle third of
    // its square composition, so the box is ~3x the visible satellite. Capped
    // by the screen's short side so it stays background-sized on phones.
    .SpaceBackground-satellite-track {
        position: absolute;
        top: 4%;
        left: 0;
        --SATELLITE-BOX: "min(var(--SATELLITE-SIZE, 12rem), 28vmin)" % "";
        width: var(--SATELLITE-BOX);
        height: var(--SATELLITE-BOX);
        animation: satellite-cruise 28s linear infinite;

        // Narrow screens have less distance to cover; keep it from crawling.
        @media (max-width: 900px), (max-height: 500px) {
            animation-duration: 18s;
        }
    }

    .SpaceBackground-satellite {
        width: 100%;
        height: 100%;
    }

    // The planet art is square with its horizon ~17% down and the planet
    // spanning the full width. Sizing it to cover the width and then centring
    // it (plain `cover`) crops the sky away on wide screens, leaving no room
    // for the stars. Instead keep it full-width and slide it down so the
    // horizon lands at --PLANET-HORIZON of the page height.
    .SpaceBackground-planet {
        --PLANET-SIZE: "max(100vw, 100vh)" % "";
        position: absolute;
        left: 50%;
        width: var(--PLANET-SIZE);
        height: var(--PLANET-SIZE);
        top: "calc(var(--PLANET-HORIZON, 40%) - 0.173 * var(--PLANET-SIZE))" % "";
        transform: translateX(-50%);
        background-repeat: no-repeat;
        background-size: 100% 100%;

        &.planet-blue { background-image: url("/1.0/backgrounds/blue.webp"); }
        &.planet-yellow { background-image: url("/1.0/backgrounds/yellow.webp"); }
        &.planet-green { background-image: url("/1.0/backgrounds/green.webp"); }
        &.planet-magenta { background-image: url("/1.0/backgrounds/magenta.webp"); }
        &.planet-red { background-image: url("/1.0/backgrounds/red.webp"); }
    }
}

@keyframes satellite-cruise {
    0% { transform: translate(100vw, 0); }
    // The dip is in vw so the flight angle is the same on every screen shape.
    100% { transform: translate(-100%, 9vw); }
}
