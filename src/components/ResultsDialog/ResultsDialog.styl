.ResultsDialog-container {
    display: flex;
    width: 100vw;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    align-items: center;
    align-content: center;
    justify-content: center;
    overflow: hidden;
    z-index: z.popup-dialog;
    // The pop-up's fill is translucent in the animation, so blur and dim the
    // game behind it rather than letting the board's grid show through.
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(6px);
}

// The pop-up is a 1920px-square composition whose frame spans roughly 15%-85%
// of the width and 29%-71% of the height; everything else in the square is
// transparent. The overlays below are positioned as fractions of the square,
// measured from the composition.
.ResultsDialog {
    // Capped in rem (1200px at the base size) so it grows with the rest of
    // the UI on big screens.
    --S: "min(110vw, 135vh, 86rem)" % "";
    position: relative;
    width: var(--S);
    height: var(--S);
    flex-shrink: 0;
    color: #32529a;
    font-family: "Rubik", "Fredoka", sans-serif;

    // The square is mostly transparent, so it lets clicks through to the
    // backdrop (which closes the pop-up); only the frame and its contents
    // take clicks.
    pointer-events: none;

    .ResultsDialog-frame {
        position: absolute;
        left: 13%;
        width: 74%;
        top: 29%;
        height: 43%;
        border-radius: 6%;
        pointer-events: auto;
    }

    .ResultsDialog-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    .ResultsDialog-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        animation: results-overlay-in 0.4s ease-out 0.5s forwards;
    }

    .ResultsDialog-avatar {
        position: absolute;
        top: 39.7%;
        width: 9%;
        height: 9%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;

        &.left { left: 29.4%; }
        &.right { left: 70.6%; }

        .Avatar, .Avatar-svg {
            width: 100%;
            height: 100%;
            min-width: 0;
            min-height: 0;
            max-width: 100%;
            max-height: 100%;
        }
    }

    .ResultsDialog-score {
        position: absolute;
        top: 45.5%;
        width: 16%;
        transform: translateX(-50%);
        font-size: calc(var(--S) * 0.016);
        line-height: 1.35;
        font-weight: 500;

        &.left { left: 29.4%; }
        &.right { left: 70.6%; }

        > div {
            display: flex;
            justify-content: space-between;
        }
        .total {
            font-weight: 700;
            border-top: 1px solid currentColor;
        }
    }

    // Sits between the two avatars above the title, styled like the "THEY
    // RESIGNED" line the animator drew into the resign pop-up.
    .ResultsDialog-note {
        position: absolute;
        top: 34.5%;
        left: 35%;
        width: 30%;
        text-align: center;
        font-size: calc(var(--S) * 0.021);
        line-height: 1.2;
        font-weight: 700;
        font-style: italic;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #2f5fd0;
    }

    // Click targets over the Play Again / View Game faces drawn in the
    // animation. They're invisible until hovered, when a soft glow shows the
    // button is clickable; Play Again (the main action) also pulses gently.
    .ResultsDialog-hotspot {
        position: absolute;
        top: 61.2%;
        width: 15%;
        height: 6%;
        transform: translate(-50%, -50%);
        cursor: pointer;
        pointer-events: auto;
        border-radius: calc(var(--S) * 0.01);
        transition: box-shadow 0.2s ease;

        &.left { left: 29.8%; }
        &.right { left: 70.9%; }

        &.primary {
            animation: results-primary-pulse 1.8s ease-in-out 1.2s infinite;
        }

        &:hover {
            animation: none;
            box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.9), 0 0 calc(var(--S) * 0.02) rgba(255, 255, 255, 0.8);
        }
    }
}

@keyframes results-primary-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    50% { box-shadow: 0 0 calc(var(--S) * 0.018) calc(var(--S) * 0.004) rgba(255, 255, 255, 0.75); }
}

@keyframes results-overlay-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
}
