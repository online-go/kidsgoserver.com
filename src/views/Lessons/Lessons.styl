@keyframes fadeIn {
  0% {opacity:0;}
  100% {opacity:1;}
}

backdropcolor=rgba(90, 90, 110, 0.6)
backdropborder-color=rgba(255, 255, 255, 0.6)

.Axol {
    background-image: svg-load("../assets/pages/lessons/axolotl.svg");
}

// Fills the board slot. The composition is square, so it takes the slot's
// shorter side; the buttons sit in the lower part of that square, under the
// axolotl, and fade in a beat after he pops in.
@keyframes lesson-complete-buttons-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
}

// Mid-lesson axolotl pages: the idle axolotl filling the board slot. His
// square composition is drawn for the Learn map's airlock window, so it's
// zoomed a little to fill the slot.
.LessonAxolotl {
    position: relative;
    width: min(100%, 100vh - 8rem);
    aspect-ratio: 1;
    max-height: 100%;
    pointer-events: none;

    .LessonAxolotl-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transform: scale(1.3);
    }
}

.LessonComplete {
    position: relative;
    width: min(100%, 100vh - 8rem);
    aspect-ratio: 1;
    max-height: 100%;

    .LessonComplete-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
    }

    // The "Complete" title ends ~83% down the composition; the button art
    // fills the middle band of its box, so this centres it ~92% down, in the
    // empty strip under the title.
    .LessonComplete-buttons {
        position: absolute;
        left: 8%;
        right: 8%;
        bottom: -9%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        opacity: 0;
        animation: lesson-complete-buttons-in 0.6s ease-out 0.9s forwards;
    }

    .LessonComplete-button {
        // The button art fills the middle ~60% of its 400px square.
        width: 34%;
        aspect-ratio: 1;
        cursor: pointer;
        transition: hover-pop-transition;

        &:hover {
            transform: scale(1.12);
        }
    }
}

#Lesson {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    align-content: center;
    align-items: stretch;
    justify-content: center;

    #Lesson-bottom-container {
        flex: 1;
        display: flex;
        flex-direction: row;

        +lessonportrait() {
            flex-direction: column;
        }
    }

    +lessonportrait() {
        #center-container {
            order: 0;
        }
        #right-container {
            display: none !important;
            visibility: hidden;
        }
        #left-container {
            order: 1;
        }
    }


    #right-container, #left-container {
        flex: 1;
        min-width: 20rem;
        max-width: 100vw;
        flex-basis: 10rem;
        min-height: 10rem;

        +lessonnarrow() {
            min-width: 15rem;
        }

        +lessonportrait() {
            flex-basis: 5rem;
            min-height: 5rem;
        }

        display: flex;
        flex-direction: column;

        +lessonportrait() {
            flex-direction: row;
        }

        align-content: space-around;
        //align-items: stretch;
        //justify-content: space-evenly;

    }
    #right-container {
        //background-color: rgba(255, 0, 0, 0.2);

    }
    #left-container {
        //background-color: rgba(0, 0, 255, 0.2);


        .bottom-graphic {
            flex: 0;
            display: flex;
            min-height: 2rem;
            height: 2rem;
            width: calc(100% - 4rem);
            margin-right: 2rem;
            margin-left: 2rem;
            border: 2px solid #fff;
            border-color: backdropborder-color
            border-top-left-radius: 1.5rem;
            border-top-right-radius: 1.5rem;
            margin-left: auto;
            margin-right: auto;
            padding-left: 1rem;
            padding-right: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            background: backdropcolor

            justify-content: center;
            align-items: center;
            
            +lessonportrait() {
                display: none !important;
            }
        }

        .sound-button {
            cursor: pointer;
            background: transparent;
            border: none;

            .sound-icon {
                width: 3rem;
                height: 3rem;
                
                &.sound-on {
                    background-image: svg-load("../assets/1.0/buttons/sound-on-hover-off.svg");
                    
                    &:hover, .sound-button:hover & {
                        background-image: svg-load("../assets/1.0/buttons/sound-on-hover-on.svg");
                    }
                }
                
                &.sound-off {
                    background-image: svg-load("../assets/1.0/buttons/sound-off-hover-off2.svg");
                    
                    &:hover, .sound-button:hover & {
                        background-image: svg-load("../assets/1.0/buttons/sound-off-hover-on2.svg");
                    }
                }
            }
        }
    }

    #board-container {
        //background-color: rgba(255, 0, 255, 0.2);

        flex: 1;
        display: flex;
        align-items: center;
        align-content: center;
        justify-content: center;

        +lessonlandscape() {
            flex-basis: 100vh // strive for square
        }
        +lessonportrait() {
            flex-basis: 100vw // strive for square
        }


        .Goban {
            background-color: transparent;
        }
        .Goban div {
            background: rgba(103, 156, 214, 0.7) !important;
            background-color: rgba(103, 156, 214, 0.7) !important;
            //opacity: 0.8;
        }

    }


    .Goban-container {
        display: inline-block;
        padding: 1.5rem;
        background: backdropcolor;
        border: 2px solid #fff;
        border-radius: 0.5rem;
        border-color: backdropborder-color

        /*
        +lessonportrait() {
            padding: 0;
            border: none;
            background: none;
        }
        */
    }


    .top-spacer {
        flex: 0;
        display: inline-block;
        min-height: 5rem;
        height: 5rem;

        +lessonportrait() {
            display: none;
        }
        +phonelandscape() {
            display: none;
        }
    }

    .landscape-bottom-buttons, .portrait-bottom-buttons {
        .game-button-container {
            display: inline-flex;
            flex-direction: column;
            align-content: center;
            align-items: center;
            justify-content: center;
            margin-left: 0.5rem
            margin-right: 0.5rem
            +lessonportrait() {
                margin-left: 0.2rem
                margin-right: 0.2rem
            }

            .button-text {
                max-width: 6rem;
                +lessonportrait() {
                    max-width: 4rem;
                }
                word-wrap: break-word;
                text-transform: uppercase;
                font-weight: bold;
                font-size: 12px;
                color: #fff;
                align-text: center;
            }
        }
    }
    .landscape-bottom-buttons{
        flex: 0;
        display: inline-flex;
        min-height: 5rem;
        height: 5rem;
        border: 2px solid #fff;
        border-color: backdropborder-color;
        border-top-left-radius: 2rem;
        border-top-right-radius: 2rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        background: backdropcolor;

        +lessonnarrow() {
            padding-left: 0.4rem;
            padding-right: 0.4rem;
        }

        +lessonportrait() {
            display: none;
        }
    }

    .portrait-bottom-buttons{
        flex: 0;
        display: inline-flex;
        min-height: 4rem;
        max-width: 100vw;
        width: 90vw;
        height: 4rem;
        border: 2px solid #fff;
        border-color: backdropborder-color;
        border-top-left-radius: 2rem;
        border-top-right-radius: 2rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 0.2rem;
        padding-right: 0.2rem;
        padding-top: 0.5rem;
        background: backdropcolor;
        align-content: center;
        align-items: stretch;
        justify-content: stretch;


        +lessonlandscape() {
            display: none;
        }

        .left, .right {
            display: inline-flex;
            flex-direction: row;
        }

        .center {
            flex: 1;
            text-align: center;
            color: #fff;
            font-weight: bold;
            font-size: 2rem;
            overflow: hidden;
        }
    }

    .landscape-top-spacer {
        flex: 0;
        height: 2rem;
        min-height: 4rem;
        max-height: 4rem;
        text-align: center;

        +lessonportrait() {
            display: none;
        }
    }

    .lesson-title {
        flex: 0;
        display: inline-flex;
        min-height: 3rem;
        min-width: 30rem;
        max-width: 80vw !important;
        display: inline-flex;
        justify-content: center;
        height: 3rem;
        padding-top: 0.5rem;
        color: #fff;
        font-size: 2rem;
        font-weight: bold;

        border: 2px solid #fff;
        border-color: backdropborder-color;
        border-bottom-left-radius: 2rem;
        border-bottom-right-radius: 2rem;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1rem;
        padding-right: 1rem;
        padding-bottom: 0.5rem;
        background: backdropcolor;
    }

    .explanation-text {
        @extend .space-font
        flex: 1;
        color: #fff;

        border-top-left-radius: 2rem;
        border-top-right-radius: 2rem;
        background: backdropcolor;
        font-size: 1.5rem;
        font-weight: bold;
        text-shadow: 0px 0px 3px #000;
        padding: 1.0rem;
        margin-left: 2rem;
        margin-right: 2rem;
        margin-top: 4rem;
        padding-top: 1.4rem;
        overflow: auto;
        max-height: calc(100vh - 10rem);

        +lessonnarrow() {
            margin-left: 0.5rem;
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }

        p {
            margin-top: 0;
        }

        +lessonportrait() {
            margin: 0;
            overflow-y: scroll;
            border-top-left-radius: 0;
            border-top-right-radius: 0;
            margin-bottom: 0.5rem;
        }
    }


    // Fills the column like the old static art, but stops growing at roughly
    // his full-screen MacBook size (the designer's reference) so big monitors
    // don't blow him up; the auto margins centre him in any leftover space.
    .Racoon {
        margin: auto 10%;
        padding: 10% 0;
        max-height: 46rem;

        +lessonnarrow() {
            margin: auto 2%;
            padding: 2% 0;
        }
    }

    a {
        text-decoration: none;
    }

    .fade-in {
        display: inline-block;
        animation: fadeIn linear 0.5s;
    }
}

#portrait-sound {
    position: absolute;
    right: 3.8rem;
    top: 1rem;
    cursor: pointer;
    
    +lessonlandscape() {
        display: none;
    }
    
    .sound-icon {
        width: 3rem;
        height: 3rem;
        
        &.sound-on {
            background-image: svg-load("../assets/1.0/buttons/sound-on-hover-off.svg");
            
            &:hover {
                background-image: svg-load("../assets/1.0/buttons/sound-on-hover-on.svg");
            }
        }
        
        &.sound-off {
            background-image: svg-load("../assets/1.0/buttons/sound-off-hover-off2.svg");
            
            &:hover {
                background-image: svg-load("../assets/1.0/buttons/sound-off-hover-on2.svg");
            }
        }
    }
}

#portrait-replay {
    position: absolute;
    right: 0.3rem;
    top: 1rem;

    +lessonlandscape() {
        display: none;
    }
}


.Axol-container {
    display: inline-flex;
    flex-direction: row;
    align-items: center;


    // Used in the lesson "Very clever!"-style popups. Those have no buttons,
    // so the axolotl can grow down into the dialog's empty button strip.
    .Axol {
        flex: 0 0 auto;
        margin: 0.5rem;
        display: inline-block;
        width: 11rem;
        height: 11rem;
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;
    }
}
