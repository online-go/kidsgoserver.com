:root {
    // Tracks the scene square, like the background and popups, so the rockets
    // scale with it instead of freezing at a fixed cap on large monitors.
    --ROCKETWIDTH: "min(20vw, 20vh)" % "";
    --ROCKETHEIGHT: calc(var(--ROCKETWIDTH) * 3);
}

#LandingPage {
    position: absolute;
    background-color: #001533;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-content: center;
    justify-content: center;
    align-items: stretch;
    overflow: hidden;

    +portrait() {
        flex-direction: column;
    }

    .spacer {
        flex-grow: 0;
        flex-shrink: 1;
        +portrait() {
            height: "calc((100vh - 100vw) / 2)" % "";
        }
        +landscape() {
            width: "calc((100vw - 100vh) / 2)" % "";
        }
    }

    .mountain-background {
        flex-grow: 1;
        position: relative;
        text-align: center;
    }

    // Holds everything except the title animation so the whole scene can start
    // as a dark silhouette and gradually brighten while the title intro plays.
    .scene {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: url("/1.0/pages/home/background_no_planets_8_13_2026.svg");
        background-repeat: no-repeat;
    }

    .scene.intro-darkened {
        animation: intro-brighten 4s ease-out forwards;
    }

    // The blue side areas outside the scene square, dimmed in step with the
    // scene's brightness filter (#001533 at brightness 0.06 ~= #000103).
    &.intro-darkened {
        animation: intro-brighten-bg 4s ease-out forwards;
    }

    .stars-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 2;
    }

    .raccoon-animation {
        position: absolute;
        bottom: 8%;
        left: 50%;
        transform: translateX(-49%);
        width: 32%;
        pointer-events: none;
        z-index: 3;
    }

    // The characters start as pure black cutouts and light up on the same curve
    // shape as the scene behind them (see intro-brighten-character). They need
    // their own filter because the scene's can't go to 0 without blacking out
    // the backdrop art too.
    .scene.intro-darkened .raccoon-animation,
    .scene.intro-darkened .learn-to-play-rocket,
    .scene.intro-darkened .play-rocket {
        animation: intro-brighten-character 4s ease-out forwards;
    }

    // Above the raccoon/stars but below the rockets, so a launching rocket
    // flies over the title/planets. During the intro the .scene filter makes
    // the scene a single layer, so the title still draws on top of it.
    .title-animation {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: z.rocket - 1;
    }

    // Lifts the hovered rocket above its neighbour: the popup is a child, so
    // it's trapped in this rocket's stacking context.
    .learn-to-play-rocket:hover, .play-rocket:hover {
        z-index: z.rocket + 2;
    }

    .learn-to-play-rocket, .play-rocket {
        position: absolute;
        // Percentage of the scene square, so the rockets stay on the green
        // ledge in the background art at every size.
        bottom: 8%;
        width: var(--ROCKETWIDTH);
        text-align: center;
        height: var(--ROCKETHEIGHT);
        z-index: z.rocket;
        cursor: pointer;

        .rocket-animation {
            position: absolute;
            top: 15%;
            left: 50%;
            width: 600%;
            height: 2500%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

    }

    // A child of its rocket, so offsets are --ROCKETWIDTH multiples and it
    // stays pinned at every aspect ratio. Width is in viewport units because a
    // % would resolve against the narrow rocket box. The bubble sits centred
    // in a square canvas about twice its width, so offsets are measured to the
    // bubble, not the canvas edge.
    .rocket-popup {
        position: absolute;
        bottom: "calc(var(--ROCKETWIDTH) * 0.86)" % "";
        width: "calc(min(100vw, 100vh) * 0.39)" % "";
        aspect-ratio: 1;
        pointer-events: none;
        z-index: z.rocket + 1;
        // Stays mounted (so the video preloads) but hidden until hover.
        visibility: hidden;

        &.visible {
            visibility: visible;
        }
    }

    // Leans inboard, into the gap before the raccoon, so it reads as belonging
    // to its rocket without covering it.
    .learn-popup {
        left: 50%;
        transform: "translateX(calc(-50% + var(--ROCKETWIDTH) * 0.89))" % "";
    }

    .play-popup {
        right: 50%;
        transform: "translateX(calc(50% - var(--ROCKETWIDTH) * 0.83))" % "";
    }

    // Inset from .mountain-background (the scene square), not the viewport, so
    // the rockets hold their place in the art at every aspect ratio.
    .learn-to-play-rocket {
        left: 9%;
    }

    .play-rocket {
        right: 9%;
    }
}

.cutscene-overlay {
    // Mounted but hidden during the launch animation so the video can buffer.
    &.preloading {
        display: none;
    }

    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    background-color: #000;
    overflow: hidden;
}

// The video and skip art are square; size each to the largest square that fits
// the viewport, centered, matching the home framing.
.cutscene-square {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: "min(100vw, 100vh)" % "";
    height: "min(100vw, 100vh)" % "";
    object-fit: contain;
}

.cutscene-video {
    opacity: 0;
    transition: opacity 0.35s ease;
}

.cutscene-video.visible {
    opacity: 1;
}

// Wraps the skip Lottie. The button art sits centered inside a large transparent
// canvas, so we shrink the canvas and tuck it into the bottom-right corner.
// Offsets are a share of that canvas, not the viewport, so the empty padding
// hangs off by the same amount everywhere -- viewport percentages pushed the
// button off the bottom of tall phones.
.cutscene-skip {
    --skip-size: "max(170px, min(42vw, 30vh))" % "";

    top: auto;
    left: auto;
    right: "calc(var(--skip-size) * -0.08)" % "";
    bottom: "calc(var(--skip-size) * -0.16)" % "";
    transform: none;
    width: var(--skip-size);
    height: var(--skip-size);
    z-index: 1001;
    cursor: pointer;

    .cutscene-square {
        top: 0;
        left: 0;
        transform: none;
        width: 100%;
        height: 100%;
    }
}

// Hold the scene as a dark silhouette while the title appears alone, then
// gradually brighten to full. The backdrop can't dim all the way to black
// without losing the art, so the characters layer their own matching curve on
// top of this one -- same shape and timing, so everything lights up in step.
@keyframes intro-brighten {
    0% {
        filter: brightness(0.06);
    }
    25% {
        filter: brightness(0.06);
    }
    100% {
        filter: brightness(1);
    }
}

// Same hold-then-ease shape and timing as intro-brighten, but from true black.
// Compounds with the scene's filter, so the characters land at full brightness
// on the same frame the backdrop does.
@keyframes intro-brighten-character {
    0% {
        filter: brightness(0);
    }
    25% {
        filter: brightness(0);
    }
    100% {
        filter: brightness(1);
    }
}

@keyframes intro-brighten-bg {
    0% {
        background-color: #000103;
    }
    25% {
        background-color: #000103;
    }
    100% {
        background-color: #001533;
    }
}
